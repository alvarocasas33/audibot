# Postgres (Neon). With the Vercel integration these come from `vercel env pull`.
DATABASE_URL=

# LLM providers: Gemini is the default (free tier); Anthropic is optional.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# API keys accepted by the service (comma-separated, allows rotation).
AUDIBOT_API_KEYS=

# Optional: concurrent LLM requests per batch (default 4).
EVAL_CONCURRENCY=
